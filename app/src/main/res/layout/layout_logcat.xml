<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.LogcatFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The live filter, behind the toolbar's filter button like the desktop log browser's. -->
    <FrameLayout
        android:id="@+id/log_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:layout_margin="16dp">

        <ScrollView
            android:id="@+id/scroolview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:ems="10"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="start|top"
                android:textIsSelectable="true"
                android:textSize="12sp"
                tools:ignore="LabelFor" />
        </ScrollView>

        <!-- New lines wait while the view is scrolled up. -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/log_jump_latest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:icon="@drawable/ic_baseline_expand_more_24"
            tools:text="@string/log_jump_latest"
            tools:visibility="visible" />

    </FrameLayout>

</LinearLayout>
